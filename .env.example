# Nextcloud, aus der die Musik gelesen wird
NEXTCLOUD_URL=https://cloud.example.org
# Eigener Service-Account mit Lesezugriff auf den Musikordner
NEXTCLOUD_USER=musik-dienst
# App-Passwort aus Nextcloud > Einstellungen > Sicherheit (nicht das Login-Passwort)
NEXTCLOUD_PASSWORD=
# Pflicht: Ordner, der gescannt wird (inkl. Unterordner), relativ zu den Dateien des Service-Users.
# Beispiel für einen geteilten Ordner: /Gemeinde/Medien/Musik  ("/" wäre der ganze Account)
NEXTCLOUD_MUSIC_PATH=/Musik

# Passwort des lokalen Admins "admin"; eine Änderung gilt nach dem Neustart. Leer: wird erzeugt und ins Log geschrieben.
# Ein "$" im Passwort als "$$" schreiben.
ADMIN_PASSWORD=
# true setzt das Passwort des lokalen Admins beim nächsten Start zurück (danach wieder entfernen)
RESET_ADMIN_PASSWORD=
# Öffentliche Adresse der App, z. B. https://musik.gemeinde.de. Ergibt die Weiterleitungs-URL für OIDC.
# Leer lassen, solange die App nur direkt über http://server:3000 läuft.
PUBLIC_URL=

# Automatischer Abgleich in Minuten, 0 = aus
SCAN_INTERVAL_MINUTES=60
# Gleichzeitige Dateizugriffe auf die Nextcloud beim Scan
SCAN_CONCURRENCY=4

LOG_LEVEL=info
