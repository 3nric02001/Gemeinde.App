{
  "name": "gemeinde-app-server",
  "version": "0.1.0",
  "private": true,
  "description": "Backend der Gemeinde.App: indexiert Musik aus Nextcloud und stellt sie per API bereit",
  "type": "module",
  "main": "dist/index.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "demo": "tsx test/demo.ts"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^13.0.3",
    "fast-xml-parser": "^5.11.2",
    "fastify": "^5.12.5",
    "music-metadata": "^11.16.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2"
  }
}
